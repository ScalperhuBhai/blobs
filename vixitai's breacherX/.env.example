# BreacherX configuration (copy to .env; all values are optional)

# --- Model routing -----------------------------------------------------------
# Provider for the AI discovery pass: "mock" (offline heuristic, default) or "anthropic".
BREACHERX_MODEL_PROVIDER=mock

# Required only when BREACHERX_MODEL_PROVIDER=anthropic.
ANTHROPIC_API_KEY=
# Triage / discovery model. Keep a cheap model for discovery, a stronger one for verification.
BREACHERX_DISCOVERY_MODEL=claude-haiku-4-5
BREACHERX_VERIFY_MODEL=claude-opus-4-8
ANTHROPIC_BASE_URL=https://api.anthropic.com

# --- Review thresholds -------------------------------------------------------
# Minimum calibrated confidence (0..1) for a finding to be published.
BREACHERX_MIN_CONFIDENCE=0.55
# Only report findings whose lines were introduced/changed by this diff.
BREACHERX_CHANGED_LINES_ONLY=true
# Max findings published per review (ranked by severity x confidence).
BREACHERX_MAX_FINDINGS=50

# --- Storage -----------------------------------------------------------------
# Where run records / findings are persisted (filesystem JSON store).
BREACHERX_DATA_DIR=.breacherx

# --- Telemetry ---------------------------------------------------------------
BREACHERX_LOG_LEVEL=info
